---
import StarButton from "./StarButton.astro";
import { scenes } from "../data/scenes";
import {
  tree,
  docs,
  treeLabel,
  treeTranscript,
  DEFAULT_DOC,
  PROJECT,
} from "../data/project";
import { source } from "../lib/markdown";
import { outro } from "../data/outro";
import { plan } from "../lib/typing";
import { toPlain } from "../lib/ansi";
import { trim } from "../lib/trim";
import { links } from "../config";

// The tree is the resting state, so it is view 1; the captured runs follow,
// and the closing prose takes the same window at the end.
const views = [
  { kind: "tree" as const, label: treeLabel, scene: null },
  ...scenes.map((scene) => ({ kind: "run" as const, label: scene.label, scene })),
  { kind: "outro" as const, label: outro.label, scene: null },
];
// The keystroke plan is generated here rather than in the browser, so the
// client script keeps no imports and stays inlined with the rest of the page.
// A visitor sees this line typed once; what has to be irregular is the timing
// within it, not the timing between page loads.
const firstDoc = docs.find((d) => d.id === DEFAULT_DOC)!;

const typePlan = JSON.stringify(
  plan(scenes[0]!.command).map((k) => ({ ...k, d: Math.round(k.d) })),
);

const total = String(views.length).padStart(2, "0");
const pad = (n: number) => String(n).padStart(2, "0");
---

<div class="screen flex min-h-svh flex-col">
  <header class="frame flex h-16 shrink-0 items-center justify-between gap-4 sm:gap-8">
    <span class="font-mono text-[0.8125rem] font-medium tracking-tight text-fg">
      agsync
    </span>

    <nav class="flex min-w-0 items-center gap-4 sm:gap-6">
      <StarButton />
      <a
        href={links.readme}
        target="_blank"
        rel="noopener"
        class="hidden text-[0.875rem] text-muted transition-colors hover:text-fg sm:inline"
      >
        Docs
      </a>
      <button
        type="button"
        data-theme-toggle
        class="grid size-8 place-items-center rounded-[8px] text-muted transition-colors hover:text-fg"
        aria-label="Toggle light and dark theme"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3">
          <circle cx="8" cy="8" r="3.1"></circle>
          <path
            d="M8 .9v1.7M8 13.4v1.7M15.1 8h-1.7M2.6 8H.9M13 3l-1.2 1.2M4.2 11.8L3 13M13 13l-1.2-1.2M4.2 4.2L3 3"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </nav>
  </header>

  <main
    class="frame flex min-h-0 flex-1 flex-col gap-8 py-8 lg:grid lg:grid-cols-[320px_minmax(0,1fr)] lg:content-center lg:items-start lg:gap-32 lg:py-20"
  >
    <div class="lg:self-center">
      <h1 class="text-[2.375rem]">ESLint for your agents&rsquo; memory</h1>

      <div class="rail-app mt-16">
        <p data-count class="font-mono text-[0.75rem] tabular-nums text-subtle">
          01 / {total}
        </p>
        <div data-labels class="relative mt-4 h-16 text-[1.0625rem] text-fg"></div>
      </div>
    </div>

    <div class="relative min-h-0">
      <div class="tex-scan" aria-hidden="true"></div>

      <div class="panel terminal flex w-full max-w-[900px] flex-col">
        <div
          data-chrome
          class="flex shrink-0 items-center gap-2 border-b border-white/[0.06] px-4 py-3 lg:px-5"
        >
          <span class="size-2.5 rounded-full bg-white/12"></span>
          <span class="size-2.5 rounded-full bg-white/12"></span>
          <span class="size-2.5 rounded-full bg-white/12"></span>
          <span
            data-chrome-title
            class="ml-2 truncate font-mono text-[0.6875rem] tracking-wide text-subtle"
          >
            {`${firstDoc.path} — ${PROJECT}`}
          </span>
          <span
            data-exit
            class="chrome-exit ml-auto font-mono text-[0.6875rem] tabular-nums text-subtle data-[code=err]:text-error data-[code=ok]:text-ok"
          ></span>
        </div>

        <div
          data-stack
          class="relative overflow-hidden px-4 py-4 lg:px-6 lg:py-5"
        >
          {
            views.map((v, i) => (
              <article class="scene" data-scene={i}>
                <div class="scene-head mb-4 mt-8 first:mt-0">
                  <p class="font-mono text-[0.75rem] tabular-nums text-subtle">
                    {pad(i + 1)} / {total}
                  </p>
                  <p data-label class="mt-1 text-[1.0625rem] text-fg">{v.label}</p>
                </div>

                {v.kind === "tree" ? (
                  <div
                    class="scene-body scene-ide"
                    data-title={`${firstDoc.path} — ${PROJECT}`}
                  >
                    <div class="ide">
                      <div
                        class="ide-tree"
                        role="group"
                        aria-label={`Files agsync reads in ${PROJECT}`}
                      >
                        {tree.map((row) =>
                          row.file ? (
                            <button
                              type="button"
                              data-file={row.file}
                              data-title={`${docs.find((d) => d.id === row.file)!.path} — ${PROJECT}`}
                              aria-current={row.file === DEFAULT_DOC ? "true" : "false"}
                              tabindex={row.file === DEFAULT_DOC ? 0 : -1}
                              class="tree-row tree-pick"
                              style={`--depth:${row.depth}`}
                            >
                              {Array.from({ length: row.depth }).map(() => (
                                <span class="tree-guide" aria-hidden="true" />
                              ))}
                              <svg class="tree-icon" viewBox="0 0 16 16" aria-hidden="true">
                                <path
                                  fill="currentColor"
                                  d="M3.4 2.2h5l4.2 4.2v7.4c0 .5-.4.9-.9.9H3.4a.9.9 0 0 1-.9-.9V3.1c0-.5.4-.9.9-.9z"
                                  opacity="0.85"
                                />
                                <path fill="var(--ide-sidebar)" d="M8.4 2.2l4.2 4.2H9.1a.7.7 0 0 1-.7-.7V2.2z" />
                              </svg>
                              <span class="tree-name">{row.name}</span>
                            </button>
                          ) : (
                            <p
                              class:list={["tree-row", row.surface ? "tree-surface" : "tree-dim"]}
                              style={`--depth:${row.depth}`}
                            >
                              {Array.from({ length: row.depth }).map(() => (
                                <span class="tree-guide" aria-hidden="true" />
                              ))}
                              {row.kind === "dir" ? (
                                <svg class="tree-icon" viewBox="0 0 16 16" aria-hidden="true">
                                  <path
                                    fill="currentColor"
                                    d="M1.5 4.2c0-.7.6-1.2 1.2-1.2h3.1c.4 0 .8.2 1 .5l.7.9h5.8c.7 0 1.2.6 1.2 1.2v6.2c0 .7-.6 1.2-1.2 1.2H2.7c-.7 0-1.2-.6-1.2-1.2V4.2z"
                                  />
                                </svg>
                              ) : (
                                <svg class="tree-icon" viewBox="0 0 16 16" aria-hidden="true">
                                  <path
                                    fill="currentColor"
                                    d="M3.4 2.2h5l4.2 4.2v7.4c0 .5-.4.9-.9.9H3.4a.9.9 0 0 1-.9-.9V3.1c0-.5.4-.9.9-.9z"
                                    opacity="0.85"
                                  />
                                  <path fill="var(--ide-sidebar)" d="M8.4 2.2l4.2 4.2H9.1a.7.7 0 0 1-.7-.7V2.2z" />
                                </svg>
                              )}
                              <span class="tree-name">{row.name}</span>
                            </p>
                          ),
                        )}
                      </div>

                      <div class="ide-editor">
                        {docs.map((doc) => (
                          <div
                            class="ide-doc"
                            data-doc={doc.id}
                            hidden={doc.id !== DEFAULT_DOC}
                          >
                            {source(doc.body).map((line, n) => (
                              <p class:list={["doc-line", `doc-${line.kind}`]}>
                                <span class="doc-num" aria-hidden="true">{n + 1}</span>
                                <span class="doc-src">
                                  {line.pieces.map((piece) => (
                                    <span class={`md-${piece.k}`}>{piece.t}</span>
                                  ))}
                                </span>
                              </p>
                            ))}
                          </div>
                        ))}
                      </div>
                    </div>
                    <pre class="sr-only">{treeTranscript}</pre>
                  </div>
                ) : v.kind === "outro" ? (
                  <div class="scene-body scene-outro" data-title="agent-memory — zsh">
                    <p class="outro-head">{outro.heading}</p>
                    <p class="outro-rule" aria-hidden="true">{outro.rule}</p>
                    <p class="outro-answer">{outro.answer}</p>

                    <div class="outro-lines">
                      {outro.lines.map((line) => (
                        <p>{line}</p>
                      ))}
                      <p class="outro-by">
                        <a href={links.author} target="_blank" rel="noopener">{outro.by.name}</a>{` — ${outro.by.note}`}
                      </p>
                    </div>

                    <div class="outro-actions">
                      <StarButton />
                      <a
                        href={links.goodFirstIssues}
                        target="_blank"
                        rel="noopener"
                        class="outro-button"
                      >
                        Add a rule
                      </a>
                      <a
                        href={links.readme}
                        target="_blank"
                        rel="noopener"
                        class="outro-button"
                      >
                        Docs
                      </a>
                    </div>
                  </div>
                ) : (
                  <div class="scene-body" data-title="agent-memory — zsh" data-exit-code={v.scene!.exit}>
                    <p class="term-line"><span class="text-accent">$ </span><span
                        data-cmd={v.scene!.command}
                        data-plan={i === 1 ? typePlan : undefined}
                        class="text-fg"
                      >{v.scene!.command}</span><span
                        data-caret
                        class="caret"
                        aria-hidden="true"
                      />{v.scene!.note && (
                        <span data-note class="text-subtle">   # {v.scene!.note}</span>
                      )}
                    </p>
                    <div class="mt-3">
                      {trim(v.scene!).map((row) =>
                        row.kind === "elision" ? (
                          <button
                            type="button"
                            data-expand
                            data-more={row.text}
                            aria-expanded="false"
                            class="term-line scene-elision"
                          >
                            {`   … ${row.text}`}
                          </button>
                        ) : (
                          <p class:list={["term-line", row.extra && "scene-extra"]}>
                            {row.spans.length === 0 ? (
                              <span>&nbsp;</span>
                            ) : (
                              row.spans.map((sp) => <span class={sp.cls}>{sp.text}</span>)
                            )}
                          </p>
                        ),
                      )}
                    </div>
                    <p class="scene-exit mt-3 font-mono text-[0.6875rem] text-subtle">
                      exit {v.scene!.exit}
                    </p>
                    <pre class="sr-only">{`$ ${v.scene!.command}\n${toPlain(v.scene!.output)}\nexit ${v.scene!.exit}`}</pre>
                  </div>
                )}
              </article>
            ))
          }
        </div>
      </div>

      <ol
        class="rail-ticks mt-8 gap-4 lg:absolute lg:right-full lg:top-1/2 lg:mt-0 lg:mr-6 lg:-translate-y-1/2 lg:flex-col lg:gap-0"
        role="list"
      >
        {
          views.map((v, i) => (
            <li>
              <button
                type="button"
                data-tick={i}
                aria-label={`Scene ${i + 1} of ${views.length}: ${v.label}`}
                class="group flex h-4 w-8 items-start"
              >
                <span class="h-px w-8 rounded-full bg-line-strong transition-all duration-200 group-hover:bg-muted group-data-[on]:h-0.5 group-data-[on]:bg-fg" />
              </button>
            </li>
          ))
        }
      </ol>
    </div>
  </main>

  <footer
    class="frame flex min-h-16 shrink-0 items-center py-4"
  >
    <p class="font-mono text-[0.75rem] text-subtle">
      MIT · zero dependencies · Python 3.11+
    </p>
  </footer>
</div>

<script>
  const root = document.documentElement;
  const stack = document.querySelector<HTMLElement>("[data-stack]");
  const panel = document.querySelector<HTMLElement>(".panel");
  const labelBox = document.querySelector<HTMLElement>("[data-labels]");
  const countEl = document.querySelector<HTMLElement>("[data-count]");
  const exitEl = document.querySelector<HTMLElement>("[data-exit]");
  const chrome = document.querySelector<HTMLElement>("[data-chrome]");
  const chromeTitle = document.querySelector<HTMLElement>("[data-chrome-title]");
  const main = document.querySelector("main");
  const articles = stack
    ? [...stack.querySelectorAll<HTMLElement>(".scene")]
    : [];
  const ticks = [...document.querySelectorAll<HTMLElement>("[data-tick]")];

  const reduced = matchMedia("(prefers-reduced-motion: reduce)");

  if (stack && panel && labelBox && countEl && exitEl && chrome && chromeTitle && main && articles.length && !reduced.matches) {
    const bodies: HTMLElement[] = [];
    const labels: HTMLElement[] = [];
    const total = String(articles.length).padStart(2, "0");

    // The label is the one part of each scene that belongs in the rail; the
    // rest of the head is redundant once the counter and ticks are up there.
    for (const article of articles) {
      const body = article.querySelector<HTMLElement>(".scene-body")!;
      const label = article.querySelector<HTMLElement>("[data-label]")!;
      label.classList.add("scene-label");
      labelBox.append(label);
      bodies.push(body);
      labels.push(label);
    }

    root.dataset.app = "";

    let index = -1;
    let flashTimer = 0;

    // An elision is a control, not a caption: it puts the lines it stands for
    // back in their original places.
    const label = (btn: HTMLElement, open: boolean) => {
      btn.textContent = open ? "   … collapse" : `   … ${btn.dataset.more}`;
      btn.setAttribute("aria-expanded", String(open));
    };

    // ---- the typewriter -------------------------------------------------
    // Driven off requestAnimationFrame against a wall clock rather than a
    // chain of timeouts: a throttled or backgrounded tab catches up on the
    // next frame instead of crawling one character per second. The keystroke
    // plan itself lives in lib/typing.ts.
    let typeRaf = 0;
    let typeHold = 0;

    const stopTyping = () => {
      cancelAnimationFrame(typeRaf);
      clearTimeout(typeHold);
    };

    const typeCommand = (body: HTMLElement, animate: boolean) => {
      stopTyping();
      const el = body.querySelector<HTMLElement>("[data-cmd]");
      body.removeAttribute("data-typing");
      if (!el) return;

      const text = el.dataset.cmd ?? "";
      if (!animate) {
        el.textContent = text;
        return;
      }

      const keys: { del?: true; c?: string; d: number }[] = JSON.parse(
        el.dataset.plan ?? "[]",
      );
      if (!keys.length) {
        el.textContent = text;
        return;
      }

      body.setAttribute("data-typing", "");
      el.textContent = "";

      let i = 0;
      let shown = "";
      let due = performance.now() + 280;

      const frame = (now: number) => {
        while (i < keys.length && now >= due) {
          const key = keys[i++]!;
          shown = key.del ? shown.slice(0, -1) : shown + key.c;
          el.textContent = shown;
          due = now + key.d;
        }
        if (i < keys.length) {
          typeRaf = requestAnimationFrame(frame);
        } else {
          // Hold the cursor a beat at the end of the line before it goes.
          typeHold = window.setTimeout(
            () => body.removeAttribute("data-typing"),
            420,
          );
        }
      };
      typeRaf = requestAnimationFrame(frame);
    };

    const collapse = (body: HTMLElement) => {
      if (!body.hasAttribute("data-expanded")) return;
      body.removeAttribute("data-expanded");
      for (const btn of body.querySelectorAll<HTMLElement>("[data-expand]")) {
        label(btn, false);
      }
    };

    // The window grows downward from a top edge that never moves, and stops at
    // the bottom of the content area. A scene that would overrun it has too
    // much output and belongs in src/lib/trim.ts, not in a scrollbar.
    const fit = () => {
      const body = bodies[index];
      if (!body) return;
      const cs = getComputedStyle(main);
      const padBottom = parseFloat(cs.paddingBottom) || 0;
      const wide = matchMedia("(min-width: 1024px)").matches;

      // Two columns: the row is centred, so the panel's own top depends on its
      // height and reading it back would be circular — measure main's content
      // box instead. Stacked, the headline sits *above* the window and eats
      // into what is left, so main's height is not the window's to take and
      // the panel's own top is the only honest starting point.
      const room = wide
        ? main.clientHeight -
          (parseFloat(cs.paddingTop) || 0) -
          padBottom -
          chrome.offsetHeight
        : main.getBoundingClientRect().bottom -
          padBottom -
          panel.getBoundingClientRect().top -
          chrome.offsetHeight;

      // The editor's panes are absolutely positioned, so the body cannot
      // report a natural height of its own; the panes can.
      const ide = body.querySelector<HTMLElement>(".ide");
      const wanted = ide
        ? [...ide.children].reduce((sum, pane) => sum + pane.scrollHeight, 0)
        : body.scrollHeight;

      // Wide enough for two columns, the window fills the height it is given,
      // the way a terminal you opened yourself would, and its edges stay put
      // between scenes. Stacked, it takes only what it needs, so the page is
      // visibly still going below it.
      const h = wide ? room : Math.min(wanted, room);
      stack.style.height = `${Math.max(0, h)}px`;
    };

    const show = (next: number) => {
      const n = Math.max(0, Math.min(articles.length - 1, next));
      if (n === index) return;
      const previous = index;
      index = n;

      bodies.forEach((b, j) => {
        const on = j === n;
        b.toggleAttribute("data-on", on);
        // Keeps six terminals' worth of output out of the accessibility tree.
        b.inert = !on;
        collapse(b);
      });
      labels.forEach((l, j) => l.toggleAttribute("data-on", j === n));
      ticks.forEach((t, j) => {
        t.toggleAttribute("data-on", j === n);
        t.setAttribute("aria-current", j === n ? "true" : "false");
      });

      countEl.textContent = `${String(n + 1).padStart(2, "0")} / ${total}`;

      chromeTitle.textContent = bodies[n]!.dataset.title ?? "";
      typeCommand(bodies[n]!, previous === 0 && n === 1);

      // The tree ran nothing, so it has no exit status and nothing to flash.
      const raw = bodies[n]!.dataset.exitCode;
      if (raw === undefined) {
        exitEl.textContent = "";
        delete panel.dataset.flash;
      } else {
        const code = Number(raw);
        exitEl.textContent = `exit ${code}`;
        exitEl.dataset.code = code === 0 ? "ok" : "err";

        panel.dataset.flash = code === 0 ? "ok" : "err";
        clearTimeout(flashTimer);
        flashTimer = window.setTimeout(() => delete panel.dataset.flash, 260);
      }

      fit();
    };

    // First measurement lands without an animation; the window is simply that
    // size on arrival.
    stack.style.transition = "none";
    show(0);
    requestAnimationFrame(() => (stack.style.transition = ""));

    addEventListener("resize", fit, { passive: true });

    // ---- the file picker --------------------------------------------------
    // Selecting swaps the editor's contents with no loading state, because
    // every document is already in the DOM. The dimmed rows are plain text
    // with no handler at all, so clicking src/ does nothing and the boundary
    // of the product teaches itself.
    const ide = stack.querySelector<HTMLElement>(".scene-ide");
    if (ide) {
      const picks = [...ide.querySelectorAll<HTMLElement>("[data-file]")];
      const dossiers = [...ide.querySelectorAll<HTMLElement>("[data-doc]")];

      const select = (pick: HTMLElement, focus: boolean) => {
        for (const other of picks) {
          const on = other === pick;
          other.setAttribute("aria-current", String(on));
          other.tabIndex = on ? 0 : -1;
        }
        for (const doc of dossiers) {
          doc.hidden = doc.dataset.doc !== pick.dataset.file;
        }
        const title = pick.dataset.title ?? "";
        ide.dataset.title = title;
        chromeTitle.textContent = title;
        if (focus) pick.focus();
        fit();
      };

      for (const pick of picks) {
        pick.addEventListener("click", () => select(pick, false));
      }

      // Arrows walk the selectable files. They must not also change scene,
      // which is what the same keys do everywhere else on the page.
      ide.addEventListener("keydown", (e) => {
        const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[
          e.key
        ];
        const here = picks.indexOf(document.activeElement as HTMLElement);
        if (step === undefined || here === -1) return;
        e.preventDefault();
        e.stopPropagation();
        select(picks[(here + step + picks.length) % picks.length]!, true);
      });
    }

    stack.addEventListener("click", (e) => {
      const btn = (e.target as Element).closest<HTMLElement>("[data-expand]");
      const body = btn?.closest<HTMLElement>(".scene-body");
      if (!btn || !body) return;
      label(btn, body.toggleAttribute("data-expanded"));
      fit();
    });

    // ---- advancing ------------------------------------------------------
    // Nothing here ever translates the layout; the gesture only changes which
    // scene is on. A scene whose output overruns the panel keeps its own
    // scrolling, so the wheel only advances once that terminal is at its edge.
    let cooling = false;
    let acc = 0;

    const beat = (dir: number) => {
      cooling = true;
      acc = 0;
      show(index + dir);
      setTimeout(() => (cooling = false), 420);
    };

    addEventListener(
      "wheel",
      (e) => {
        e.preventDefault();
        if (cooling) return;
        acc += e.deltaY;
        if (Math.abs(acc) > 36) beat(acc > 0 ? 1 : -1);
      },
      { passive: false },
    );

    let touchY: number | null = null;
    addEventListener(
      "touchstart",
      (e) => (touchY = e.touches[0]?.clientY ?? null),
      { passive: true },
    );
    addEventListener(
      "touchmove",
      (e) => {
        const y = e.touches[0]?.clientY;
        if (touchY === null || y === undefined) return;
        const dy = touchY - y;
        e.preventDefault();
        if (cooling || Math.abs(dy) < 44) return;
        touchY = y;
        beat(dy > 0 ? 1 : -1);
      },
      { passive: false },
    );
    addEventListener("touchend", () => (touchY = null), { passive: true });

    const STEP: Record<string, number> = {
      ArrowDown: 1, ArrowRight: 1, PageDown: 1, " ": 1,
      ArrowUp: -1, ArrowLeft: -1, PageUp: -1,
    };
    addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const el = document.activeElement;
      if (el && /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName)) return;
      if (el?.closest(".ide-tree")) return; // the file tree owns its arrows

      const step = STEP[e.key];
      if (step) {
        e.preventDefault();
        show(index + step);
      } else if (e.key === "Home") {
        e.preventDefault();
        show(0);
      } else if (e.key === "End") {
        e.preventDefault();
        show(articles.length - 1);
      }
    });

    for (const tick of ticks) {
      tick.addEventListener("click", () =>
        show(Number(tick.dataset.tick)),
      );
    }

    // A mid-session change of the motion preference reloads into the other
    // mode rather than unpicking the DOM surgery.
    reduced.addEventListener("change", () => location.reload());
  }
</script>
