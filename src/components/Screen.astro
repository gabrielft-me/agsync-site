---
import StarButton from "./StarButton.astro";
import { scenes } from "../data/scenes";
import { toPlain } from "../lib/ansi";
import { trim } from "../lib/trim";
import { links } from "../config";

const rendered = scenes.map((s) => ({ ...s, rows: trim(s) }));
const total = String(scenes.length).padStart(2, "0");
const pad = (n: number) => String(n).padStart(2, "0");
---

<div class="screen flex min-h-svh flex-col">
  <header class="frame flex h-16 shrink-0 items-center justify-between gap-8">
    <span class="font-mono text-[0.8125rem] font-medium tracking-tight text-fg">
      agsync
    </span>

    <nav class="flex items-center gap-6">
      <StarButton />
      <a
        href={links.readme}
        target="_blank"
        rel="noopener"
        class="text-[0.875rem] text-muted transition-colors hover:text-fg"
      >
        Docs
      </a>
      <button
        type="button"
        data-theme-toggle
        class="grid size-8 place-items-center rounded-[8px] text-muted transition-colors hover:text-fg"
        aria-label="Toggle light and dark theme"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3">
          <circle cx="8" cy="8" r="3.1"></circle>
          <path
            d="M8 .9v1.7M8 13.4v1.7M15.1 8h-1.7M2.6 8H.9M13 3l-1.2 1.2M4.2 11.8L3 13M13 13l-1.2-1.2M4.2 4.2L3 3"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </nav>
  </header>

  <main
    class="frame flex min-h-0 flex-1 flex-col gap-8 py-8 lg:grid lg:grid-cols-[320px_minmax(0,1fr)] lg:items-start lg:gap-32 lg:py-20"
  >
    <div class="lg:self-center">
      <h1 class="text-[2.375rem]">ESLint for your agents&rsquo; memory</h1>

      <div class="rail-app mt-16">
        <p data-count class="font-mono text-[0.75rem] tabular-nums text-subtle">
          01 / {total}
        </p>
        <div data-labels class="relative mt-4 h-16 text-[1.0625rem] text-fg"></div>
      </div>
    </div>

    <div class="relative min-h-0">
      <div class="tex-scan" aria-hidden="true"></div>

      <div class="panel terminal flex w-full max-w-[900px] flex-col">
        <div
          data-chrome
          class="flex shrink-0 items-center gap-2 border-b border-white/[0.06] px-4 py-3 lg:px-5"
        >
          <span class="size-2.5 rounded-full bg-white/12"></span>
          <span class="size-2.5 rounded-full bg-white/12"></span>
          <span class="size-2.5 rounded-full bg-white/12"></span>
          <span class="ml-2 font-mono text-[0.6875rem] tracking-wide text-subtle">
            agent-memory — zsh
          </span>
          <span
            data-exit
            class="chrome-exit ml-auto font-mono text-[0.6875rem] tabular-nums text-subtle data-[code=err]:text-error data-[code=ok]:text-ok"
          ></span>
        </div>

        <div
          data-stack
          class="relative overflow-hidden px-4 py-4 lg:px-6 lg:py-5"
        >
          {
            rendered.map((s, i) => (
              <article class="scene" data-scene={i}>
                <div class="scene-head mb-4 mt-8 first:mt-0">
                  <p class="font-mono text-[0.75rem] tabular-nums text-subtle">
                    {pad(s.n)} / {total}
                  </p>
                  <p data-label class="mt-1 text-[1.0625rem] text-fg">
                    {s.label}
                  </p>
                </div>

                <div class="scene-body" data-exit-code={s.exit}>
                  <p class="term-line">
                    <span class="text-accent">$ </span>
                    <span class="text-fg">{s.command}</span>
                    {s.note && <span class="text-subtle">   # {s.note}</span>}
                  </p>
                  <div class="mt-3">
                    {s.rows.map((row) =>
                      row.kind === "elision" ? (
                        <button
                          type="button"
                          data-expand
                          data-more={row.text}
                          aria-expanded="false"
                          class="term-line scene-elision"
                        >
                          {`   … ${row.text}`}
                        </button>
                      ) : (
                        <p class:list={["term-line", row.extra && "scene-extra"]}>
                          {row.spans.length === 0 ? (
                            <span>&nbsp;</span>
                          ) : (
                            row.spans.map((sp) => <span class={sp.cls}>{sp.text}</span>)
                          )}
                        </p>
                      ),
                    )}
                  </div>
                  <p class="scene-exit mt-3 font-mono text-[0.6875rem] text-subtle">
                    exit {s.exit}
                  </p>
                  <pre class="sr-only">{`$ ${s.command}\n${toPlain(s.output)}\nexit ${s.exit}`}</pre>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <ol
        class="rail-ticks mt-8 gap-4 lg:absolute lg:right-full lg:top-1/2 lg:mt-0 lg:mr-6 lg:-translate-y-1/2 lg:flex-col lg:gap-0"
        role="list"
      >
        {
          scenes.map((s, i) => (
            <li>
              <button
                type="button"
                data-tick={i}
                aria-label={`Scene ${s.n} of ${scenes.length}: ${s.label}`}
                class="group flex h-4 w-8 items-start"
              >
                <span class="h-px w-8 rounded-full bg-line-strong transition-all duration-200 group-hover:bg-muted group-data-[on]:h-0.5 group-data-[on]:bg-accent" />
              </button>
            </li>
          ))
        }
      </ol>
    </div>
  </main>

  <footer
    class="frame flex min-h-16 shrink-0 flex-wrap items-center justify-between gap-x-8 gap-y-2 py-4"
  >
    <p class="font-mono text-[0.75rem] text-subtle">
      MIT · zero dependencies · Python 3.11+
    </p>
    <p class="text-[0.8125rem] text-subtle">
      If this finds nothing, your memory files are fine. That is also
      information.
    </p>
  </footer>
</div>

<script>
  const root = document.documentElement;
  const stack = document.querySelector<HTMLElement>("[data-stack]");
  const panel = document.querySelector<HTMLElement>(".panel");
  const labelBox = document.querySelector<HTMLElement>("[data-labels]");
  const countEl = document.querySelector<HTMLElement>("[data-count]");
  const exitEl = document.querySelector<HTMLElement>("[data-exit]");
  const chrome = document.querySelector<HTMLElement>("[data-chrome]");
  const main = document.querySelector("main");
  const articles = stack
    ? [...stack.querySelectorAll<HTMLElement>(".scene")]
    : [];
  const ticks = [...document.querySelectorAll<HTMLElement>("[data-tick]")];

  const reduced = matchMedia("(prefers-reduced-motion: reduce)");

  if (stack && panel && labelBox && countEl && exitEl && chrome && main && articles.length && !reduced.matches) {
    const bodies: HTMLElement[] = [];
    const labels: HTMLElement[] = [];
    const total = String(articles.length).padStart(2, "0");

    // The label is the one part of each scene that belongs in the rail; the
    // rest of the head is redundant once the counter and ticks are up there.
    for (const article of articles) {
      const body = article.querySelector<HTMLElement>(".scene-body")!;
      const label = article.querySelector<HTMLElement>("[data-label]")!;
      label.classList.add("scene-label");
      labelBox.append(label);
      bodies.push(body);
      labels.push(label);
    }

    root.dataset.app = "";

    let index = -1;
    let flashTimer = 0;

    // An elision is a control, not a caption: it puts the lines it stands for
    // back in their original places.
    const label = (btn: HTMLElement, open: boolean) => {
      btn.textContent = open ? "   … collapse" : `   … ${btn.dataset.more}`;
      btn.setAttribute("aria-expanded", String(open));
    };

    const collapse = (body: HTMLElement) => {
      if (!body.hasAttribute("data-expanded")) return;
      body.removeAttribute("data-expanded");
      for (const btn of body.querySelectorAll<HTMLElement>("[data-expand]")) {
        label(btn, false);
      }
    };

    // The window grows downward from a top edge that never moves, and stops at
    // the bottom of the content area. A scene that would overrun it has too
    // much output and belongs in src/lib/trim.ts, not in a scrollbar.
    const fit = () => {
      const body = bodies[index];
      if (!body) return;
      const pad = parseFloat(getComputedStyle(main).paddingBottom) || 0;
      const room =
        main.getBoundingClientRect().bottom -
        pad -
        panel.getBoundingClientRect().top -
        chrome.offsetHeight;
      // Wide enough for two columns: the window fills the height it is given,
      // the way a terminal you opened yourself would, and its top and bottom
      // edges stay put between scenes. Stacked, it shrinks to its output so
      // the page below it stays reachable.
      const fills = matchMedia("(min-width: 1024px)").matches;
      const h = fills ? room : Math.min(body.scrollHeight, room);
      stack.style.height = `${Math.max(0, h)}px`;
    };

    const show = (next: number) => {
      const n = Math.max(0, Math.min(articles.length - 1, next));
      if (n === index) return;
      index = n;

      bodies.forEach((b, j) => {
        const on = j === n;
        b.toggleAttribute("data-on", on);
        // Keeps six terminals' worth of output out of the accessibility tree.
        b.inert = !on;
        collapse(b);
      });
      labels.forEach((l, j) => l.toggleAttribute("data-on", j === n));
      ticks.forEach((t, j) => {
        t.toggleAttribute("data-on", j === n);
        t.setAttribute("aria-current", j === n ? "true" : "false");
      });

      countEl.textContent = `${String(n + 1).padStart(2, "0")} / ${total}`;

      const code = Number(bodies[n]!.dataset.exitCode ?? 0);
      exitEl.textContent = `exit ${code}`;
      exitEl.dataset.code = code === 0 ? "ok" : "err";

      panel.dataset.flash = code === 0 ? "ok" : "err";
      clearTimeout(flashTimer);
      flashTimer = window.setTimeout(() => delete panel.dataset.flash, 260);

      fit();
    };

    // First measurement lands without an animation; the window is simply that
    // size on arrival.
    stack.style.transition = "none";
    show(0);
    requestAnimationFrame(() => (stack.style.transition = ""));

    addEventListener("resize", fit, { passive: true });

    stack.addEventListener("click", (e) => {
      const btn = (e.target as Element).closest<HTMLElement>("[data-expand]");
      const body = btn?.closest<HTMLElement>(".scene-body");
      if (!btn || !body) return;
      label(btn, body.toggleAttribute("data-expanded"));
      fit();
    });

    // ---- advancing ------------------------------------------------------
    // Nothing here ever translates the layout; the gesture only changes which
    // scene is on. A scene whose output overruns the panel keeps its own
    // scrolling, so the wheel only advances once that terminal is at its edge.
    let cooling = false;
    let acc = 0;

    const beat = (dir: number) => {
      cooling = true;
      acc = 0;
      show(index + dir);
      setTimeout(() => (cooling = false), 420);
    };

    addEventListener(
      "wheel",
      (e) => {
        e.preventDefault();
        if (cooling) return;
        acc += e.deltaY;
        if (Math.abs(acc) > 36) beat(acc > 0 ? 1 : -1);
      },
      { passive: false },
    );

    let touchY: number | null = null;
    addEventListener(
      "touchstart",
      (e) => (touchY = e.touches[0]?.clientY ?? null),
      { passive: true },
    );
    addEventListener(
      "touchmove",
      (e) => {
        const y = e.touches[0]?.clientY;
        if (touchY === null || y === undefined) return;
        const dy = touchY - y;
        e.preventDefault();
        if (cooling || Math.abs(dy) < 44) return;
        touchY = y;
        beat(dy > 0 ? 1 : -1);
      },
      { passive: false },
    );
    addEventListener("touchend", () => (touchY = null), { passive: true });

    const STEP: Record<string, number> = {
      ArrowDown: 1, ArrowRight: 1, PageDown: 1, " ": 1,
      ArrowUp: -1, ArrowLeft: -1, PageUp: -1,
    };
    addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const el = document.activeElement;
      if (el && /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName)) return;

      const step = STEP[e.key];
      if (step) {
        e.preventDefault();
        show(index + step);
      } else if (e.key === "Home") {
        e.preventDefault();
        show(0);
      } else if (e.key === "End") {
        e.preventDefault();
        show(articles.length - 1);
      }
    });

    for (const tick of ticks) {
      tick.addEventListener("click", () =>
        show(Number(tick.dataset.tick)),
      );
    }

    // A mid-session change of the motion preference reloads into the other
    // mode rather than unpicking the DOM surgery.
    reduced.addEventListener("change", () => location.reload());
  }
</script>
