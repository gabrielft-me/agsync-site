---
// Source for public/og.png. Visit /og, screenshot the 1200x630 card, and save
// it over public/og.png. Kept as a route so the image can never drift from the
// captured output the page itself shows.
import "../styles/global.css";
import { scenes } from "../data/scenes";
import { toLines } from "../lib/ansi";

const scene = scenes[0]!;
const all = toLines(scene.output);
// Head, an explicit truncation mark, then the summary the whole card is for.
const head = all.slice(0, 5);
const tail = all.slice(-2);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>agsync — OG card</title>
    <style>
      body { margin: 0; }
      #card { width: 1200px; height: 630px; }
      #card .term-line { font-size: 14px; line-height: 1.65; }
    </style>
  </head>
  <body>
    <div id="card" class="flex flex-col justify-between bg-bg px-16 pt-14 pb-16">
      <div>
        <p class="font-mono text-[22px] font-medium text-muted">agsync</p>
        <h1 class="mt-6 text-[56px] leading-[1.04] tracking-[-0.025em] text-fg">
          ESLint for your agents&rsquo; memory
        </h1>
      </div>

      <div class="terminal rounded-panel border border-line-strong bg-terminal px-7 py-6">
        <p class="term-line">
          <span class="text-accent">$ </span><span class="text-fg">{scene.command}</span>
        </p>
        <div class="mt-3">
          {
            head.map((spans) => (
              <p class="term-line">
                {spans.map((sp) => (
                  <span class={sp.cls}>{sp.text}</span>
                ))}
              </p>
            ))
          }
          <p class="term-line text-subtle">   &#8942;</p>
          {
            tail.map((spans) => (
              <p class="term-line">
                {spans.map((sp) => (
                  <span class={sp.cls}>{sp.text}</span>
                ))}
              </p>
            ))
          }
        </div>
      </div>

      <p class="font-mono text-[17px] text-subtle">
        MIT · zero dependencies · Python 3.11+
      </p>
    </div>
  </body>
</html>
